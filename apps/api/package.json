{
  "name": "@psydog/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env -- tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma": "dotenv -e ../../.env -- prisma",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@psydog/shared": "workspace:*",
    "@telegram-apps/init-data-node": "^2.0.10",
    "fastify": "^5.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
