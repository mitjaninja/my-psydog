BOT_TOKEN=
BOT_USERNAME=          # username бота без @, для ссылок-приглашений
WEBAPP_URL=https://<tunnel-or-domain>
DATABASE_URL=postgresql://app:app@localhost:5432/app
ADMIN_TG_IDS=123456789
NOTES_ENCRYPTION_KEY=   # 32 байта base64: openssl rand -base64 32
NODE_ENV=development

# --- Только для прода (docker-compose.yml) ---
DOMAIN=                # домен Mini App, напр. app.example.ru
POSTGRES_PASSWORD=     # пароль БД в контейнере; DATABASE_URL compose собирает сам
